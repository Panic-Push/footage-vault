<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console test runner (no test framework packages), so tests run anywhere with `dotnet run`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FootageVault.Core\FootageVault.Core.csproj" />
  </ItemGroup>
</Project>
