<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 desktop app, unpackaged (installed by a normal setup.exe, not MSIX) and self-contained
    (carries its own .NET and Windows App SDK runtime, so nothing else needs installing).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FootageVault</RootNamespace>
    <AssemblyName>FootageVault</AssemblyName>
    <Product>Footage Vault</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FootageVault.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Needed even without MSIX: builds the resource index (.pri) that WinUI loads its compiled XAML from. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootageVault.Core\FootageVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\FootageVault.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
