<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FootageVault.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,6" />
        </Style>
        <!-- Windows 11 Settings-style row: icon, title, description, control -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <TextBlock Text="Uploads" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8F4;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Uploads at the same time" />
                    <TextBlock Text="2 is good for most office connections. More only splits a slow link." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox Grid.Column="2" x:Name="ParallelBox" Minimum="1" Maximum="4" SpinButtonPlacementMode="Inline" Width="130" ValueChanged="OnNumberChanged" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEC4A;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Daily upload limit" />
                    <TextBlock x:Name="LimitInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <NumberBox Grid.Column="2" x:Name="Limit" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Inline" Width="130" ValueChanged="OnNumberChanged" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8AC;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Rename folders and files on disk" />
                    <TextBlock Text="When you upload, renamed folders and every uploaded video file get names that match their titles." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" x:Name="Rename" Toggled="OnToggled" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D2;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Video description" />
                    <TextBlock Text="Use {Story} and {Date}. Applies to clips added from now on." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="Description" Width="320" LostFocus="OnTextCommitted" />
            </Grid>

            <TextBlock Text="YouTube" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE77B;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Google account" />
                    <TextBlock x:Name="AccountInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="SignOutButton" Content="Sign out" Click="OnSignOut" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D7;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Google client file" />
                    <TextBlock x:Name="ClientInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="Choose file" Click="OnChooseClient" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA18;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Google API audit approved" />
                    <TextBlock Text="Turn on only after Google confirms the audit. Until then uploads are Private." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" x:Name="Audit" Toggled="OnToggled" OnContent="Approved" OffContent="Not yet" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72E;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Upload as" />
                    <TextBlock Text="Unlisted is available once the audit is approved." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="2" x:Name="Privacy" Width="150" SelectionChanged="OnSelection">
                    <ComboBoxItem Content="Private" Tag="private" />
                    <ComboBoxItem Content="Unlisted" Tag="unlisted" />
                </ComboBox>
            </Grid>

            <TextBlock Text="Log and storage" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8A5;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Upload log folder" />
                    <TextBlock x:Name="LogInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Open" Click="OnOpenLog" />
                    <Button Content="Change" Click="OnChangeLog" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App data" />
                    <TextBlock Text="Settings, the upload queue and the technical log (for troubleshooting)." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="Open folder" Click="OnOpenData" />
            </Grid>

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" FontSize="18" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App theme" />
                    <TextBlock Text="The accent colour always follows Windows." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ComboBox Grid.Column="2" x:Name="Theme" Width="200" SelectionChanged="OnSelection">
                    <ComboBoxItem Content="Use system setting" Tag="system" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Dark" Tag="dark" />
                </ComboBox>
            </Grid>

            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/FootageVault.ico" Width="20" Height="20" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Footage Vault" />
                    <TextBlock x:Name="VersionInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
