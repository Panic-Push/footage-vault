<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FootageVault.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:FootageVault.Helpers"
    xmlns:vm="using:FootageVault.ViewModels"
    Background="Transparent">

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search titles, stories, file names or video IDs" QueryIcon="Find"
                            Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search history" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.Stories}" SelectedIndex="{x:Bind Vm.StoryIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Filter by story" />
        </Grid>

        <Grid Grid.Row="2">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
                <AppBarButton Label="Copy link" Click="OnCopy">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Copy all links" Click="OnCopyAll" ToolTipService.ToolTip="Copy the title and link of every result shown">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Open on YouTube" Click="OnOpen">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Export" Click="OnExport" ToolTipService.ToolTip="Save these results as a CSV file for Excel">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <TextBlock Text="{x:Bind Vm.Count, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView Grid.Row="3" x:Name="List" ItemsSource="{x:Bind Vm.Items}" SelectionMode="Single"
                  DoubleTapped="OnDoubleTapped" AutomationProperties.Name="Upload history"
                  Visibility="{x:Bind h:Ui.Hide(Vm.IsEmpty), Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItem">
                    <Grid ColumnSpacing="14" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE930;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  Visibility="{x:Bind h:Ui.Show(Uploaded)}" />
                        <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  Visibility="{x:Bind h:Ui.Hide(Uploaded)}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Source}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind When}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind h:Ui.Show(Vm.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="No uploads to show" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <TeachingTip x:Name="CopiedTip" Title="Copied" IsLightDismissEnabled="True" PreferredPlacement="Bottom" />
    </Grid>
</Page>
