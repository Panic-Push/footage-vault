<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain .NET library: no NuGet packages, no Windows-only APIs, so it builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FootageVault.Core</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FootageVault.Core.Tests" />
  </ItemGroup>
</Project>
